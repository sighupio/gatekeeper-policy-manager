Use of this source code is governed by a BSD-style
license that can be found in the LICENSE file.

Generic error page. Mirrors the fields the React Error page shows: a message, a suggested action,
the error details, an optional "Log in" button when a session expired, and a "Go back" link.
*/ -}}
{{- define "content" -}}
<div class="view centered">
  <div class="centered-box">
    {{- /* A refusal is not a malfunction: it keeps the heading it was given and drops the warning
           mark, so a permission boundary does not read as something to report. */}}
    <h1 class="error-title">
      {{- if .Err.Fault }}<span class="error-mark" aria-hidden="true">&#9888;</span> {{ end }}
      {{- .Err.Title }}</h1>

    {{- with .Err.Message }}
    <h2>{{ . }}</h2>
    {{- end }}

    {{- with .Err.Action }}
    <p class="muted">{{ . }}</p>
    {{- end }}

    {{- with .Err.Description }}
    {{- /* A fault gets the red box, because something needs fixing. A refusal gets plain text: the
           boundary is working, and there is no third alert style worth inventing for it. */}}
    {{- if $.Err.Fault }}
    <div class="alert alert-error">{{ . }}</div>
    {{- else }}
    <p class="muted">{{ . }}</p>
    {{- end }}
    {{- end }}

    <div class="centered-actions">
      {{- with .Err.LoginURL }}
      <a class="btn" href="{{ . }}">Log in</a>
      {{- end }}
      <a class="btn btn-ghost" href="{{ .Err.BackURL }}">Go back</a>
    </div>
  </div>
</div>
{{- end -}}
