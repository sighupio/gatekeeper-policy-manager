Use of this source code is governed by a BSD-style
license that can be found in the LICENSE file.

Configurations view. Renders the Gatekeeper Config objects the JSON handler getConfigs returns.
*/ -}}
{{- define "content" -}}
<div class="view">
  <div class="view-head">
    <h1>Configurations</h1>
    <p class="muted">Gatekeeper's own <code>Config</code>: the resources it syncs into its cache and any namespaces it excludes.</p>
  </div>

  {{- if .Error }}
  <div class="alert alert-error">{{ .Error }}</div>

  {{- else if not .Configs }}
  <div class="empty">
    <h2>No configurations</h2>
    <p class="muted">There are no Gatekeeper <code>Config</code> objects defined in this cluster.</p>
  </div>

  {{- else }}
  <div class="layout-sidebar">
    <aside class="sidebar">
      <p class="sidebar-title">Configurations</p>
      <nav class="sidebar-nav">
        {{- range .Configs }}
        <a href="#{{ .metadata.name }}">{{ .metadata.name }}</a>
        {{- end }}
      </nav>
    </aside>

    <div class="stack">
      {{- range .Configs }}
      <section class="card" id="{{ .metadata.name }}">
        <div class="card-head">
          <h2>{{ .metadata.name }}</h2>
          {{- with .metadata.namespace }}
          <span class="tag"><span class="tag-key">namespace</span> {{ . }}</span>
          {{- end }}
        </div>

        {{- with .spec }}
        <div class="field">
          <p class="field-label">Spec</p>
          <pre class="code chroma"><code>{{ highlight (toYAML .) "yaml" }}</code></pre>
        </div>
        {{- else }}
        <p class="muted no-spec">This configuration has no spec defined.</p>
        {{- end }}

        <details class="field">
          <summary>Full YAML definition</summary>
          <pre class="code chroma"><code>{{ highlight (toYAML .) "yaml" }}</code></pre>
        </details>

        {{- with .metadata.creationTimestamp }}
        <p class="card-foot muted">Created on {{ . }}</p>
        {{- end }}
      </section>
      {{- end }}
    </div>
  </div>
  {{- end }}
</div>
{{- end -}}
