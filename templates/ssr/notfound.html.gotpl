{{- define "content" -}}
<div class="view centered">
  <div class="centered-box">
    <h1 class="notfound-code">404</h1>
    <h2>Page not found</h2>
    <div class="centered-actions">
      <a class="btn" href="{{ browserPath `/ssr/home` }}">Go to home</a>
    </div>
  </div>
</div>
{{- end -}}
