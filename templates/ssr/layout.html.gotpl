Copyright (c) 2017-present SIGHUP s.r.l All rights reserved.
Use of this source code is governed by a BSD-style
license that can be found in the LICENSE file.

Base layout for the server-rendered UI. Pages fill the "content" block and pass a .Layout with the
nav, context switcher and footer data (see ssrLayoutData in ssr.go).
*/ -}}
{{- define "layout" -}}
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ .Layout.Title }} · Gatekeeper Policy Manager</title>
  <link rel="icon" href="{{ .Layout.AssetBase }}/logo.svg">
  <link rel="stylesheet" href="{{ .Layout.AssetBase }}/app.css">
  <link rel="stylesheet" href="{{ .Layout.AssetBase }}/chroma.css">
  {{- /* Apply the saved theme before first paint so there is no light/dark flash. External and
         synchronous so it runs before Alpine and needs no script-src 'unsafe-inline' under the CSP. */}}
  <script src="{{ .Layout.AssetBase }}/theme.js"></script>
  <script src="{{ .Layout.AssetBase }}/width.js"></script>
  <script defer src="{{ .Layout.AssetBase }}/alpine.min.js"></script>
  <script defer src="{{ .Layout.AssetBase }}/sidebar-spy.js"></script>
</head>
<body>
  <header class="topbar">
    <a class="brand" href="{{ browserPath `/` }}" title="Home">
      <img class="brand-logo" src="{{ .Layout.AssetBase }}/logo.svg" alt="" height="30">
      <span class="brand-text">Gatekeeper Policy Manager</span>
    </a>

    <nav class="nav" aria-label="Main">
      {{- range .Layout.Nav }}
      <a class="nav-link{{ if .Active }} is-active{{ end }}" href="{{ .Href }}"
         {{ if .Active }}aria-current="page"{{ end }}>{{ .Name }}</a>
      {{- end }}
    </nav>

    <div class="topbar-actions">
      {{- if .Layout.HasContexts }}
      <label class="ctx" >
        <span class="ctx-label">Context</span>
        {{- /* x-data makes this select an Alpine root so x-on:change is actually wired up; without
               it Alpine never processes the directive and switching context does nothing. */}}
        {{- $current := "" }}
        {{- range .Layout.Contexts }}{{ if .Selected }}{{ $current = .Name }}{{ end }}{{ end }}
        <select class="ctx-select" aria-label="Kubernetes context" title="{{ $current }}" x-data
                x-on:change="if ($event.target.value) window.location.href = $event.target.value">
          {{- range .Layout.Contexts }}
          <option value="{{ .URL }}"{{ if .Selected }} selected{{ end }}>{{ .Name }}</option>
          {{- end }}
        </select>
      </label>
      {{- end }}

      <button type="button" class="icon-btn" title="Layout width"
              x-data="widthToggle()" x-on:click="toggle()" x-bind:title="title"
              aria-label="Layout width">
        {{- /* The icon shows the layout in force: content between margins, or filling the window. The
               static geometry is the centred one, so it draws correctly before Alpine boots. */}}
        <svg viewBox="0 0 16 16" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" aria-hidden="true">
          <rect x="4.5" y="3.5" width="7" height="9" rx="1" x-bind:x="full ? 1.5 : 4.5" x-bind:width="full ? 13 : 7"/>
          <path x-show="!full" d="M1.5 3.5v9M14.5 3.5v9"/>
        </svg>
      </button>

      <button type="button" class="icon-btn" title="Theme"
              x-data="themeToggle()" x-on:click="cycle()" x-bind:title="title">
        <span x-text="icon">☾</span>
      </button>

      {{- if .Layout.AuthEnabled }}
      <a class="btn" href="{{ .Layout.LogoutURL }}">Log out</a>
      {{- end }}
    </div>
  </header>

  <main class="page">
    {{- block "content" . }}{{ end }}
  </main>

  <footer class="footer">
    <div>
      <strong>Gatekeeper Policy Manager {{ .Layout.Version }}</strong>
      <span class="muted">A simple web UI for OPA Gatekeeper</span>
    </div>
    <div class="footer-right muted">
      Proud part of the
      <a href="https://docs.sighup.io/" target="_blank" rel="noopener">SIGHUP Distribution</a>
      ·
      <a href="https://github.com/sighupio/gatekeeper-policy-manager" target="_blank" rel="noopener">Source</a>
    </div>
  </footer>
</body>
</html>
{{- end -}}

{{- /* The failure banner for a view whose Kubernetes call failed. Closed by default, so a long
client-go error does not push the page around; why it carries the detail is in setViewError. */ -}}
{{- define "viewerror" -}}
<div class="alert alert-error">{{ .Error }}
  {{- with .ErrorDetail }}
  <details class="alert-detail">
    <summary>Details</summary>
    <pre>{{ . }}</pre>
  </details>
  {{- end }}
</div>
{{- end -}}
